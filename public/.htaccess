# ══════════════════════════════════════════════
#  MB Patrimoine & Finance — Apache / Hostinger
# ══════════════════════════════════════════════

# ── Activer le moteur de réécriture ──
Options -MultiViews
RewriteEngine On

# ── Forcer HTTPS ──
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Forcer www → sans www (adapter si besoin) ──
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── SPA : renvoyer index.html pour toutes les routes ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ══ Compression Gzip ══
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ══ Cache navigateur ══
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — pas de cache (toujours frais)
  ExpiresByType text/html                 "access plus 0 seconds"

  # Assets Vite (hash dans le nom → cache long)
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"

  # Images
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Polices
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"

  # JSON / sitemap / robots
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
</IfModule>

# ══ En-têtes de sécurité ══
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Cache-Control sur les assets hashés Vite
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pas de cache sur HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ══ Types MIME manquants ══
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/javascript .js .mjs
</IfModule>

# ══ Pages d'erreur personnalisées ══
ErrorDocument 404 /index.html
